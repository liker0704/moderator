# ============================================
# Database Configuration
# ============================================

# PostgreSQL database name
DB_NAME=moderator_db

# PostgreSQL username
DB_USER=moderator

# PostgreSQL password (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -base64 32
DB_PASSWORD=your_secure_password_here

# Database host (use 'db' for Docker Compose, 'localhost' for local dev)
DB_HOST=db

# Database port (default PostgreSQL port)
DB_PORT=5432


# ============================================
# Telegram Bot Configuration
# ============================================

# Telegram Bot Token from @BotFather
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (the moderator)
# Get your ID from @userinfobot
MODERATOR_TG_USER_ID=your_telegram_user_id_here


# ============================================
# Encryption Configuration
# ============================================

# Fernet encryption key for storing Discord token securely in database
# IMPORTANT: Generate a unique key for each installation!
#
# Generate with one of these methods:
#   Method 1 (Python): python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Method 2 (OpenSSL): openssl rand -base64 32
#
# Example output: dGhpc19pc19hX3NhbXBsZV9rZXlfZG9fbm90X3VzZQ==
ENCRYPTION_KEY=your_fernet_encryption_key_here


# ============================================
# LLM Configuration (v0.2+)
# ============================================

# LLM Provider: 'openai' or 'anthropic'
LLM_PROVIDER=openai

# Model selection
LLM_MODEL=gpt-4-turbo
# Options for OpenAI: gpt-4-turbo, gpt-4, gpt-3.5-turbo
# Options for Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307

# API Keys (provide one based on LLM_PROVIDER)
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here


# ============================================
# Alert Configuration
# ============================================

# Telegram Chat ID for system alerts and notifications
# This can be the same as MODERATOR_TG_USER_ID or a separate chat
# System will send alerts about errors, connection issues, etc.
ALERT_CHAT_ID=your_telegram_chat_id_for_alerts


# ============================================
# Logging Configuration
# ============================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# Use DEBUG for development, INFO for production
LOG_LEVEL=INFO


# ============================================
# Optional: Redis Configuration (v0.2+)
# ============================================

# Redis host (use 'redis' for Docker Compose, 'localhost' for local dev)
# REDIS_HOST=redis

# Redis port (default Redis port)
# REDIS_PORT=6379

# Redis password (leave empty if no password)
# REDIS_PASSWORD=


# ============================================
# Metrics Configuration (v1.0+)
# ============================================

# Enable Prometheus metrics endpoint
# Default: false (disabled for security)
# METRICS_ENABLED=false

# Metrics server port (default: same as HEALTH_CHECK_PORT)
# METRICS_PORT=8000

# Gauge metrics update interval in seconds (default: 60)
# METRICS_UPDATE_INTERVAL=60
